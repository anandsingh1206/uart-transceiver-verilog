`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
/* -----------------------------------------------------------------------------
 * File        : uart_rx_3block.v
 * Author      : Anand Singh
 * Date        : April 2026
 * Description : Full-duplex UART Transmitter module. 
 * Implemented using a robust 3-block Moore state machine 
 * for glitch-free serialization and optimal synthesis.
 * ----------------------------------------------------------------------------- */
//////////////////////////////////////////////////////////////////////////////////




module uart_rx_3block #(
    parameter CLK_FREQ = 50000000, // 50 MHz
    parameter BAUD_RATE = 9600     // 9600 bps
)(
    input  wire       clk,
    input  wire       rst,
    input  wire       rx,          // Incoming serial data
    output reg  [7:0] data_out,    // The fully received byte
    output reg        rx_done      // High when a full byte is ready
);

   
    // STATE ENCODING
   
    localparam IDLE  = 2'b00;
    localparam START = 2'b01;
    localparam DATA  = 2'b10;
    localparam STOP  = 2'b11;

    reg [1:0] current_state, next_state;

   
    // THE 16x BAUD GENERATOR
 
    // We need a tick that is 16 times faster than the baud rate
    localparam BAUD_16X_LIMIT = (CLK_FREQ / (BAUD_RATE * 16)) - 1;
    
    reg [15:0] baud_counter;
    wire       baud_16x_tick;

    assign baud_16x_tick = (baud_counter == BAUD_16X_LIMIT);

    always @(posedge clk) begin
        if (rst) begin
            baud_counter <= 16'd0;
        end else begin
            if (baud_16x_tick) baud_counter <= 16'd0;
            else               baud_counter <= baud_counter + 16'd1;
        end
    end

   
    // DATAPATH REGISTERS
  
    reg [3:0] tick_counter; // Counts 0 to 15 to find the middle of a bit
    reg [2:0] bit_index;    // Counts 0 to 7 for the 8 data bits
    reg [7:0] shift_reg;    // Temporarily holds the bits as they come in

   
    // BLOCK 1: FSM State Memory (Sequential)
 
    always @(posedge clk) begin
        if (rst) current_state <= IDLE;
        else     current_state <= next_state;
    end

  
    // BLOCK 2: Next State Logic (Combinational)
    // Decides when to move to the next state based on the 16x timer.
    
    always @(*) begin
        next_state = current_state; // Default

        case (current_state)
            IDLE: begin
                if (rx == 1'b0) next_state = START; // Falling edge detected
            end

            START: begin
                if (baud_16x_tick) begin
                    if (tick_counter == 4'd7) begin // We are at the middle of the Start bit
                        if (rx == 1'b0) next_state = DATA; // Still 0? Valid start bit.
                        else            next_state = IDLE; // Was a glitch, abort.
                    end
                end
            end

            DATA: begin
                if (baud_16x_tick && tick_counter == 4'd15) begin
                    // If we just sampled the 8th bit (index 7), move to STOP
                    if (bit_index == 3'd7) next_state = STOP;
                end
            end

            STOP: begin
                // Wait until the middle of the stop bit to declare we are done
                if (baud_16x_tick && tick_counter == 4'd15) begin
                    next_state = IDLE;
                end
            end
            
            default: next_state = IDLE;
        endcase
    end

   
    // BLOCK 3: FSM Output Logic (Combinational)
    // Pure Moore Machine outputs.
    
    always @(*) begin
        rx_done = 1'b0;

        case (current_state)
            STOP:    rx_done = 1'b1; // Signal the main system the byte is ready
            default: rx_done = 1'b0;
        endcase
    end

   
    // DATAPATH LOGIC (Sequential)
    // Manages the counters and shifting in the data bits based on FSM state.
    
    always @(posedge clk) begin
        if (rst) begin
            tick_counter <= 4'd0;
            bit_index    <= 3'd0;
            shift_reg    <= 8'd0;
            data_out     <= 8'd0;
        end else begin
            case (current_state)
                IDLE: begin
                    tick_counter <= 4'd0;
                    bit_index    <= 3'd0;
                end

                START: begin
                    if (baud_16x_tick) begin
                        if (tick_counter == 4'd7) tick_counter <= 4'd0; // Reset for DATA state
                        else                      tick_counter <= tick_counter + 4'd1;
                    end
                end

                DATA: begin
                    if (baud_16x_tick) begin
                        if (tick_counter == 4'd15) begin
                            tick_counter <= 4'd0;
                            shift_reg    <= {rx, shift_reg[7:1]}; // Shift the new bit in (LSB first)
                            bit_index    <= bit_index + 3'd1;
                        end else begin
                            tick_counter <= tick_counter + 4'd1;
                        end
                    end
                end

                STOP: begin
                    if (baud_16x_tick) begin
                        if (tick_counter == 4'd15) begin
                            data_out     <= shift_reg; // Lock the received byte into the output register
                            tick_counter <= 4'd0;
                        end else begin
                            tick_counter <= tick_counter + 4'd1;
                        end
                    end
                end
            endcase
        end
    end

endmodule
